# Copy to .env for the default three-PU profile.
COMPOSE_PROFILES=multi
# One PU: set COMPOSE_PROFILES= and NODES=pu-1=http://pu-1:8080, POOL_MAX=24.
NODES=pu-1=http://pu-1:8080,pu-2=http://pu-2:8080,pu-3=http://pu-3:8080
POOL_MAX=8
POSTGRES_CPUS=1.0
RATE=100
DURATION=60s
WARMUP=10s
SCENARIO=constant
DISTRIBUTION=uniform
